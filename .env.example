APP_NAME=RehabAI
APP_ENV=development
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000

# Comma-separated origins allowed to call /api/*
ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional override; defaults to http://HOST:PORT
API_BASE_URL=

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
MAX_JSON_BODY_BYTES=1000000
